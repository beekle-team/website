{
  "$schema": "https://biomejs.dev/schemas/1.4.1/schema.json",
  "files": {
    "ignore": [
      "dist/**",
      "node_modules/**",
      ".astro/**",
      ".vscode/**",
      ".wrangler/**",
      ".tmp/**",
      "*.generated.*",
      "src/data/column-embeddings.json",
      "docs/marketing/data/**",
      "claudedocs/backups/**",
      ".ops/natural-japanese-audit.json",
      ".ops/natural-japanese-lp-entries.json",
      "scripts/audit-natural-japanese-full.mjs",
      "scripts/audit-natural-japanese-lp-entries.mjs"
    ]
  },
  "organizeImports": {
    "enabled": true
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "a11y": {
        "noSvgWithoutTitle": "off",
        "useButtonType": "off"
      },
      "suspicious": {
        "noArrayIndexKey": "off"
      }
    },
    "ignore": [
      ".astro",
      "dist/**",
      "astro.config.mjs",
      "node_modules/**",
      "*.generated.*",
      "src/lib/requirements-content-upgrades.js",
      "scripts/rewrite-requirements-content-2026-08-19.mjs"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "ignore": [".astro", "dist/**", "node_modules/**", "*.generated.*"]
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "trailingCommas": "es5"
    }
  }
}
