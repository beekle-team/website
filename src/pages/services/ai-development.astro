---
import { AskAiButton } from '@/components/ask-ai-button';
import { Header } from '@/components/header';
import JsonLd from '@/components/seo/json-ld.astro';
import SectionVisual from '@/components/services/section-visual.astro';
import ServiceFigure from '@/components/services/service-figure.astro';
import { testimonialData } from '@/components/testimonial-section';
import { Section } from '@/components/ui';
import ReadingVisual from '@/components/visuals/reading-visual.astro';
import { AI_PAIR, PROJECT_MONTHS, pocEstimate, projectEstimate } from '@/data/engagement-pricing';
import { services } from '@/data/service';
import Layout from '@/layouts/layout.astro';
import { CircleDollarSign, ListChecks, MonitorPlay, Smile, Target } from 'lucide-react';

export const prerender = false;

const siteUrl = 'https://beekle.jp';
const serviceUrl = `${siteUrl}/services/ai-development`;
const title = '生成AI受託開発｜業務成果から要件定義、PoC・本番運用まで | Beekle';
const description =
  '生成AI開発は、業務成果から要件を決められる会社へ。Beekleは削減したい作業・費用、成功条件、人の確認まで設計し、PoCから本番運用まで一貫して支援。NDA締結後に実データで0円のデモを作り、完成像を見てから準委任で進めるか判断できます。';

const aiDevelopmentService = services.find((service) => service.id === 'ai-development');
if (!aiDevelopmentService) {
  throw new Error('AI development service data not found');
}
const relatedColumns = aiDevelopmentService.relatedColumns?.slice(0, 3) ?? [];

const customerVoice = testimonialData.find((item) => item.id === 5);

const businessBenefits = [
  {
    icon: ListChecks,
    title: '手作業が減る。',
    body: '資料探し、転記、集計。繰り返す作業をAIに任せる。',
  },
  {
    icon: Smile,
    title: '毎日の仕事が楽に。',
    body: '同じ質問への対応や、単純作業に追われる時間を減らす。',
  },
  {
    icon: CircleDollarSign,
    title: '対応コストを減らす。',
    body: '残業や外注に頼っていた作業を減らし、費用を抑える。',
  },
  {
    icon: Target,
    title: '大事な仕事に集中。',
    body: '提案、顧客対応、業務改善。時間を使いたかった仕事へ。',
  },
] as const;

const strengths = [
  {
    icon: Target,
    worry: '目的が曖昧で、効果を測れない',
    title: '減らす仕事と、成功条件を決める。',
    body: '誰のどの作業を減らすか。今の作業時間・件数・費用と、目指す状態を整理し、投資に見合うかを判断できる要件にします。',
  },
  {
    icon: MonitorPlay,
    worry: '頼んでみないと、分からない？',
    title: '商談中に、動くデモを見る。',
    body: 'ご相談内容をもとにデモを用意。画面や操作で認識のズレを確認しながら、どの作業をAIに任せられそうか、業務で使える見込みを早く確かめます。',
  },
  {
    icon: ListChecks,
    worry: '使えないと分かるまでに、お金がかかる',
    title: '見込みがなければ、深追いしない。',
    body: '続行・変更・中止の条件を先に決め、不確実な点だけを検証。人の確認工数や費用を含めて見合わなければ、方式変更・AIを使わない・開発を見送る判断をします。',
  },
] as const;

const proofs = [
  {
    label: 'ヒアリングから動作デモ',
    number: '1',
    unit: '日',
    title: '構想を、その日のうちに画面へ。',
    body: '議事録から仕様を作り、デモを実装。「イメージとずれていない」と確認いただきました。',
    href: '/case-studies?case=demo-in-a-day#demo-in-a-day',
  },
  {
    label: 'HR AIエージェントのPoC',
    number: '2',
    unit: '週間',
    title: 'PoCを経て、本開発3か月へ。',
    body: '採点ロジックとAIの分析を分離。診断・分析・レポート出力まで一つの業務フローに実装。',
    href: '/case-studies?case=hr-ai-agent#hr-ai-agent',
  },
  {
    label: '難航した開発の引き継ぎ',
    number: '3',
    unit: '週間',
    title: '画面からインフラまで再構築。',
    body: '3か月停滞した案件を動作する状態へ。発注元が委託した外部セキュリティチェックも一度で通過。',
    href: '/case-studies?case=recovery#recovery',
  },
] as const;

const process = [
  {
    title: 'NDA',
    body: '秘密保持契約を結び、実際の業務データをお預かり。',
    output: '情報の扱いを合意',
  },
  {
    title: '成果を決める',
    body: '減らしたい作業・費用と、成功条件を整理。',
    output: '業務成果を要件にする',
  },
  {
    title: '0円のデモで見極める',
    body: '実データで動かし、AIを業務に使える見込みを双方で確認。',
    output: '合わなければ、ここで終了',
  },
  {
    title: '稟議・ご判断',
    body: 'デモ、狙う効果、PoCの範囲と体制で社内検討。',
    output: '実現の見込みがあればPoCへ',
  },
  {
    title: 'PoC・開発・運用',
    body: '準委任で必要な検証を行い、連携・権限・運用まで実装。',
    output: '現場で使える仕組みへ',
  },
] as const;

const capabilities = [
  {
    title: '社内文書検索・ナレッジ検索',
    body: '規程、FAQ、マニュアル、過去対応を横断し、回答と根拠を返します。',
    technologies: 'RAG / ベクトル検索 / Reranking / GraphRAG / Milvus / pgvector / Neo4j',
  },
  {
    title: 'AIエージェント',
    body: 'API、データベース、社内システムをまたぐ作業を進めます。重要な操作には人の承認を入れ、実行ログを残します。',
    technologies: 'Function Calling / MCP / API連携',
  },
  {
    title: 'AI OCR・帳票読み取り',
    body: '請求書、申込書、PDF、画像から必要な項目を読み取り、判断が必要な箇所だけ人に戻します。',
  },
  {
    title: '既存システムへの生成AI組み込み',
    body: 'ChatGPT、Claude、Geminiなどの機能を、今使っている管理画面や業務システムへ組み込みます。',
  },
  {
    title: 'AIを使った新規プロダクト',
    body: 'AI検索、マッチング、レコメンド、翻訳、分析など、中核となる体験から小さく検証します。',
  },
] as const;

const deliverables = [
  '現状業務とTo-Beの整理',
  '削減対象・効果測定の指標・投資判断の基準',
  '業務ごとのユースケース',
  '必要データ・正本・権限の定義',
  '正解例・NG例・境界例を含む評価データ',
  'AIが答える条件・人に戻す条件',
  '仕様とテストの対応関係',
  '本番システム・インフラ構成',
  '運用開始後の評価・改善ルール',
] as const;

const operations = [
  'AIモデル・APIの変更への対応',
  '検索・回答品質の定期評価',
  '文書・業務データの更新',
  '障害監視とログ確認',
  '権限・セキュリティの見直し',
  'AI利用料・インフラ費の改善',
] as const;

const aiPocEstimate = pocEstimate({ members: AI_PAIR, monthsMin: 1 });
const aiProjectEstimate = projectEstimate({ members: AI_PAIR, ...PROJECT_MONTHS });

const pricePlans = [
  {
    title: '検証用の叩き台（ゼロスタート）',
    price: '0円',
    body: 'NDAを結び、実際の業務データをお預かりして確認したうえで、1業務の代表データでコアのAI機能が動く叩き台を作ります。開発を進める価値があるかを双方で判断できるところまでが範囲で、全量データ、権限、連携、確認画面、評価セットの整備は含めません。合わなければ、双方ここで終了。費用は発生しません。',
  },
  {
    title: 'PoC（実データで業務として成立するか）',
    price: '準委任（月額）',
    body: `叩き台で実現の見込みを確認できた場合だけ進みます。モデルケースの体制と費用の目安は${aiPocEstimate}。叩き台で分かったデータの状態と難しさをもとに、確かめる範囲と体制を再見積もりします。単価は職種別に公開しています。`,
  },
  {
    title: 'MVP・本番開発・運用',
    price: '準委任（月額）',
    body: `PoCの結果を見て、画面、連携、権限、運用まで同じ体制で続けます。PoCから本番展開までの全体は、多くの案件で${aiProjectEstimate}。判断の軸として置いている数字で、範囲を狭める、方式を変える、見送る判断も各段階でできます。`,
  },
] as const;

const proposalExamples = [
  'GraphRAG＋AIナレッジ検索＋PDF約30ファイルの検証：2か月 / 340万円（税別）',
  'PDF＋動画文字起こしを含むPoC：2か月 / 560万円（税別）',
  '全量データを使う本格PoC・プロトタイプ：4か月 / 780万円（税別）',
] as const;

const productionCostFactors = [
  '既存システムとの連携数',
  'データ量とデータ整備',
  'RAG / GraphRAGの構成',
  'AIエージェントが実行する処理',
  '権限・監査ログ',
  '精度要件',
  'セキュリティ要件',
] as const;

const faq = [
  {
    question: '生成AIの開発会社は、何を基準に選ぶべきですか？',
    answer:
      '業務上の成果から要件を決められるかを確認してください。どの作業をどれだけ減らすか、何をもって検証成功とするか、人の確認や運用費を含めて効果が残るか。本番の連携・例外対応まで説明できる会社を選ぶことが大切です。Beekleは業務整理から要件・受入条件を定義し、同じチームで検証・実装・運用へつなぎます。',
  },
  {
    question: 'デモを見てから、発注や社内稟議を進められますか？',
    answer:
      'はい。NDA締結後に業務を伺い、商談中に動くデモをご提示します。完成イメージを確認し、開発範囲・見積もりと合わせて社内説明や稟議を進められます。デモの範囲は相談内容に応じて調整します。',
  },
  {
    question: '商談のデモと、有償のPoCは何が違いますか？',
    answer:
      'デモは0円です。NDA締結後に実データを確認し、対象業務を絞って動くものを作り、AIを業務に使えそうかを双方で見極めます。見込みがなければ、そこで終了でき、費用はかかりません。実現の見込みがあれば、デモで分かったデータの状態と難しさをもとに、確かめる範囲と体制を再見積もりし、準委任（月額）でPoCへ進みます。デモだけで本番の品質を保証するものではありません。',
  },
  {
    question: 'まだ何を作るか決まっていなくても相談できますか？',
    answer:
      'できます。開発会社の選び方やAIの技術に詳しくなくても、要件書がなくても構いません。NDAを結んだうえで業務を伺い、商談中のデモを見ながら、作るものと進め方を一緒に整理します。',
  },
  {
    question: '生成AI開発の不確実性は、どうやって減らしますか？',
    answer:
      'まず、どの作業をAIに任せられるかを0円のデモで早く確かめます。業務に耐える見込みがなければ、方式変更・AIを使わない・開発を見送る判断をします。残る不確実性だけを、実データと合格条件を決めたPoCで検証。精度だけでなく、確認工数や運用費を含めて、続行・変更・中止を判断します。',
  },
  {
    question: 'なぜ最初から全部PoCしないのですか？',
    answer:
      '画面、権限、業務フローなど、すでに作り方が分かっている部分まで検証すると時間と費用が増えるからです。不確実なところだけを検証します。',
  },
  {
    question: 'RAGとは何ですか？',
    answer:
      'RAGは、社内文書やFAQを検索し、その内容を根拠に生成AIへ回答させる仕組みです。Embedding、ベクトルDB、Reranking、GraphRAG、評価設計まで対応します。',
  },
  {
    question: 'GraphRAGは、どんなときに使いますか？',
    answer:
      '似た文章を探すだけでは答えにくく、複数の情報の関係をたどる必要がある場合に検討します。通常RAGで必要な品質に届くなら、構成を複雑にしません。',
  },
  {
    question: 'AIエージェントも開発できますか？',
    answer:
      'できます。API、データベース、社内システムを呼び分けて仕事を進めるAIエージェントを設計・実装します。MCP、Function Callingにも対応します。',
  },
  {
    question: '社外秘データや個人情報は扱えますか？',
    answer:
      '扱えます。利用するAI・クラウド、データの保存場所、権限、マスキング、監査ログなどを要件に合わせて設計します。',
  },
] as const;
---

<Layout title={title} description={description} canonical={serviceUrl}>
  <JsonLd slot="head" type="service" data={{ serviceName: '生成AI受託開発', serviceDescription: description, url: serviceUrl, serviceType: '生成AI受託開発', image: `${siteUrl}/og-image.png` }} />
  <JsonLd slot="head" type="breadcrumb" data={{ items: [{ name: 'ホーム', url: '/' }, { name: '生成AI受託開発', url: '/services/ai-development' }] }} />
  <JsonLd slot="head" type="faq" data={{ faqs: faq.map((item) => ({ question: item.question, answer: item.answer })) }} />

  <Header />
  <main class="ai-development bg-neutral-50 pt-20">
    <Section padding="sm" variant="light" decoration="none" containerClass="mx-auto max-w-7xl">
      <div class="grid items-center gap-8 lg:grid-cols-[1.05fr_1fr] lg:gap-12">
        <div>
          <p class="eyebrow">Beekleの生成AI受託開発</p>
          <h1 class="mt-5 text-4xl font-bold leading-[1.4] tracking-tight text-accent-950 sm:text-5xl lg:text-[3.25rem]">
            本開発の前に、<br /><span class="text-primary-600">見て、試して、</span><br />決められる。
          </h1>
          <p class="mt-5 max-w-lg text-base leading-8 text-neutral-700 md:text-lg">どこに頼めばいいか分からなくても、大丈夫。<br class="hidden sm:block" />NDAを結び、商談中に動くデモをご用意。<br class="hidden sm:block" />完成像を見ながら、社内稟議まで進められます。</p>
          <div class="mt-7 flex flex-col items-start gap-2">
            <a href="/contact?source=services-ai-development-hero&intent=ai-development" data-cta-source="services-ai-development-hero" data-cta-id="contact" class="primary-link w-full sm:w-auto">NDA・デモから相談する <span aria-hidden="true">→</span></a>
            <p class="text-sm leading-7 text-neutral-600">NDA後の検証用デモは0円。合わなければ、そこで終了できます。要件書は不要です。</p>
          </div>
        </div>
        <figure class="relative overflow-hidden rounded-lg bg-white">
          <img src="/images/services/generative-ai-business-prototype.webp" alt="画面を囲み、業務での使い方を確認する商談のイメージ" width="1600" height="900" fetchpriority="high" class="aspect-[4/3] w-full object-cover object-right lg:aspect-[1/1]" />
          <figcaption class="border-t border-neutral-200 px-5 py-4 md:px-6">
            <p class="text-lg font-bold text-accent-950">「こういうことがしたかった」を、画面で。</p>
            <p class="mt-1 text-sm leading-6 text-neutral-600">商談のイメージ。実際のデモはご相談内容に合わせて用意します。</p>
          </figcaption>
        </figure>
      </div>
      <nav aria-label="このページの見どころ" class="mt-10 grid grid-cols-2 gap-x-6 border-t border-neutral-300 pt-4 md:grid-cols-4">
        <a href="#why-now" class="text-link no-underline">今、取り組む理由 <span aria-hidden="true">↓</span></a>
        <a href="#why-beekle" class="text-link no-underline">Beekleの強み <span aria-hidden="true">↓</span></a>
        <a href="#how" class="text-link no-underline">相談からの流れ <span aria-hidden="true">↓</span></a>
        <a href="#proof" class="text-link no-underline">実績とお客様の声 <span aria-hidden="true">↓</span></a>
      </nav>
    </Section>

    <Section id="why-now" className="scroll-mt-20" padding="sm" variant="white" decoration="none" containerClass="mx-auto max-w-6xl">
      <div class="relative overflow-hidden rounded-lg bg-accent-950">
        <img src="/images/services/ai-business-transformation-v1.webp" alt="散らばった文書が、確認しやすい情報へ変わるイメージ" width="1600" height="900" loading="lazy" decoding="async" class="w-full lg:absolute lg:inset-0 lg:h-full lg:object-cover" />
        <div class="pointer-events-none absolute inset-y-0 left-0 hidden w-3/5 bg-accent-950/90 lg:block" aria-hidden="true"></div>
        <div class="relative px-6 pb-8 md:px-10 lg:max-w-[56%] lg:py-14">
          <p class="eyebrow text-primary-200">WHY NOW — 今、AIに投資すべき理由</p>
          <h2 class="section-title text-white">毎日の手作業を減らし、<br />もっと大事な仕事へ。</h2>
          <p class="mt-5 max-w-md text-base leading-8 text-white/90">資料探し、転記、同じ問い合わせへの回答。繰り返す作業をAIに任せて、現場の負担と対応コストを減らします。</p>
        </div>
      </div>
      <div class="mt-8 grid gap-6 md:grid-cols-2 lg:gap-8">
        {businessBenefits.map(({ icon: Icon, ...item }) => (
          <article class="border-t border-neutral-300 pt-5">
            <Icon size={30} strokeWidth={1.5} className="text-primary-600" aria-hidden="true" />
            <h3 class="mt-4 text-lg font-bold leading-relaxed text-accent-950">{item.title}</h3>
            <p class="mt-3 text-sm leading-7 text-neutral-700">{item.body}</p>
          </article>
        ))}
      </div>
      <div class="mt-8 rounded-lg border border-neutral-200 bg-white p-6 md:p-8">
        <p class="text-sm font-semibold text-neutral-600">たとえば、帳票の入力</p>
        <div class="mt-4 grid items-center gap-3 md:grid-cols-[1fr_auto_1fr] md:gap-6">
          <p class="text-lg font-semibold leading-8 text-neutral-700">1件ずつ読んで、<br />書き写して、チェックする。</p>
          <span class="text-2xl text-primary-500" aria-hidden="true"><span class="md:hidden">↓</span><span class="hidden md:inline">→</span></span>
          <p class="text-xl font-bold leading-8 text-primary-700">AIが読み取り、<br />人は確認・修正する。</p>
        </div>
        <a href="/demos/ocr" class="text-link mt-4">読み取りデモを試す <span aria-hidden="true">→</span></a>
      </div>
      <div class="mt-8 grid gap-4 border-y border-neutral-300 py-6 md:grid-cols-[0.85fr_1.15fr] md:gap-10">
        <h3 class="text-xl font-bold leading-relaxed text-accent-950">毎月繰り返す仕事こそ、<br />減らした効果が続いていく。</h3>
        <div>
          <p class="copy">先送りする間も、同じ作業に時間と費用がかかります。まずは負担の大きい仕事を一つ。人の確認やAIの利用料も含め、どれだけ楽になり、コストを減らせるかを確かめます。</p>
          <a href="#how" class="text-link mt-2">自社の仕事で確かめるには <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </Section>

    <Section id="why-beekle" className="scroll-mt-20" padding="sm" variant="light" decoration="none" containerClass="mx-auto max-w-6xl">
      <p class="eyebrow">WHY BEEKLE — AI DXを成果へ</p>
      <h2 class="section-title">AI開発は、ビジネス目線で<br class="hidden sm:block" />要件を決められる会社へ。</h2>
      <ReadingVisual name="unclear-scope-v1" />
      <SectionVisual name="requirements-chain-v1" />
      <p class="copy mt-5 max-w-3xl">Beekleは「どの業務を、どれだけ減らすか」から設計します。動くデモで業務に使える見込みを早く確かめ、難しければ変更・撤退を判断。大きく投資する前に、不確実性を減らします。</p>

      <div class="mt-8 overflow-hidden rounded-lg border border-neutral-300 bg-white">
        <div class="grid md:grid-cols-[0.8fr_1.2fr]">
          <div class="bg-accent-950 p-6 text-white md:p-8">
