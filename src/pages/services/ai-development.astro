---
import { AskAiButton } from '@/components/ask-ai-button';
import { AskAiSection } from '@/components/ask-ai-section';
import { Header } from '@/components/header';
import JsonLd from '@/components/seo/json-ld.astro';
import ServiceCaseStudies from '@/components/services/service-case-studies.astro';
import { Section, SectionHeader } from '@/components/ui';
import { services } from '@/data/service';
import Layout from '../../layouts/layout.astro';

export const prerender = false;

const siteUrl = 'https://beekle.jp';
const serviceUrl = `${siteUrl}/services/ai-development`;
const title = '生成AI受託開発｜PoC・RAG・AIエージェントを本番運用まで | Beekle';
const description =
  '生成AIの受託開発。業務を整理し、作り方が分かっている部分は早く形にし、検索精度・AI判断・OCRなど試さないと分からない部分だけをPoCで検証します。RAG・GraphRAG、AIエージェント、AI OCR、評価設計、本番運用まで対応します。';

const aiDevelopmentService = services.find((service) => service.id === 'ai-development');
if (!aiDevelopmentService) {
  throw new Error('AI development service data not found');
}
const relatedColumns = aiDevelopmentService.relatedColumns?.slice(0, 3) ?? [];

const painPoints = [
  {
    title: 'AIを使いたいが、どの業務から始めるべきか決められない',
    body: 'ツールやモデルから選ぶのではなく、今の仕事のどこに時間がかかっているかを見て、効果を確かめやすい業務から絞ります。',
  },
  {
    title: 'PoCは動いたが、本番へ進める判断材料が足りない',
    body: '「動いた」で終わらせず、精度、削減時間、人の確認工数、失敗の種類を測り、本番へ進む条件を決めます。',
  },
  {
    title: '社内データを使うと、回答が安定しない',
    body: '検索方式だけでなく、正本、版管理、権限、データの関係、答えてはいけない条件まで含めて見直します。',
  },
  {
    title: 'AI SaaSを導入したが、人の作業が思ったほど減らない',
    body: 'AI単体ではなく、前後の入力、確認、承認、既存システム連携まで含めて業務フローを作り直します。',
  },
] as const;

const uncertaintyTypes = [
  {
    label: 'そのまま作れる',
    title: '作り方が分かっていること',
    examples: '画面、権限、入力項目、業務フロー、既存API連携など',
    action: '要件に落として、そのまま実装します。',
  },
  {
    label: '実物を見れば決められる',
    title: 'データや現行環境を見れば分かること',
    examples: '文書の種類、データの揺れ、既存システムの仕様、更新方法など',
    action: '必要に応じてNDAを結び、早い段階で実物を確認します。',
  },
  {
    label: 'PoCで確かめる',
    title: '実際に試さないと分からないこと',
    examples: '検索精度、AIの判断、OCRの読み取り、生成品質、費用と速度など',
    action: 'この部分だけ、評価基準を決めてPoCします。',
  },
] as const;

const uncertaintyResolution = [
  ['1', '業務を決める', '誰の、どの作業を減らすかを決めます。'],
  ['2', '失敗例を先に集める', '正解だけでなく、NG例・境界例・情報不足のケースも用意します。'],
  ['3', '合格条件を決める', '精度だけでなく、削減時間、人の確認工数、重大な誤りを含めて決めます。'],
  ['4', '実データで試す', 'ダミーデータだけで判断せず、本番に近い条件で検証します。'],
  [
    '5',
    'Go / No-Goを決める',
    '満たさなければ、用途を狭める、人の確認を残す、方式を変える、見送るを判断します。',
  ],
] as const;

const buildFlow = [
  ['業務', '誰が、何をしているか'],
  ['To-Be', 'どの作業を減らすか'],
  ['ユースケース', '誰が何をできればよいか'],
  ['データ', '何を根拠に使うか'],
  ['AI・検索', 'どこをAIに任せるか'],
  ['評価', '何ができたら完成か'],
] as const;

const proofs = [
  {
    title: 'ヒアリングから、1日で動くデモまで',
    body: 'ヒアリング議事録から提案内容を整理し、そのまま1日で動作するデモまで進めた案件があります。実物を見てもらい、早い段階で認識のズレを確認しました。',
    note: '分かっている部分は、議論を続けるより早く形にします。',
  },
  {
    title: 'HR領域のAIプロダクト',
    body: '心理学モデルを使うAIでは、PoCを約2週間で実施し、本開発を約3か月で進めました。HEXACO-100の採点はプロンプト任せにせず、逆転項目や集計をロジックとして実装。LLMの出力もJSON Schemaで固定しました。',
    note: 'AIに任せる部分と、決め打ちするロジックを分けています。',
  },
  {
    title: '社内ヘルプデスクAI',
    body: 'FAQを整理し、AIが一次回答。答えられない質問だけ情シスへ引き継ぐ形にしました。',
    metrics: ['定型質問の75%をAIが回答', '回答待ちが4時間から5分へ', '情シスに月30時間を戻した'],
    note: 'AIの精度だけでなく、人の仕事がどれだけ減ったかまで見ます。',
  },
] as const;

const process = [
  {
    title: '業務と現行データを確認する',
    body: '利用者、作業、判断、例外、既存システム、使っているデータを確認します。',
  },
  {
    title: '分かっている部分を先に形にする',
    body: '画面や業務フローなど、作れば確認できる部分は早くプロトタイプにします。',
  },
  {
    title: '不確実な部分だけPoCする',
    body: '検索精度、AI OCR、AI判断など、試さないと分からない部分だけを評価します。',
  },
  {
    title: '条件を満たした範囲を本番化する',
    body: '権限、ログ、監視、既存システム連携、人の確認フローまで含めて本番へ載せます。',
  },
] as const;

const capabilities = [
  {
    title: '社内文書検索・ナレッジ検索',
    body: '規程、FAQ、マニュアル、過去対応を横断し、回答と根拠を返します。',
    technologies: 'RAG / ベクトル検索 / Reranking / GraphRAG / Milvus / pgvector / Neo4j',
  },
  {
    title: 'AIエージェント',
    body: 'API、データベース、社内システムをまたぐ作業を進めます。重要な操作には人の承認を入れ、実行ログを残します。',
    technologies: 'Function Calling / MCP / API連携',
  },
  {
    title: 'AI OCR・帳票読み取り',
    body: '請求書、申込書、PDF、画像から必要な項目を読み取り、判断が必要な箇所だけ人に戻します。',
  },
  {
    title: '既存システムへの生成AI組み込み',
    body: 'ChatGPT、Claude、Geminiなどの機能を、今使っている管理画面や業務システムへ組み込みます。',
  },
  {
    title: 'AIを使った新規プロダクト',
    body: 'AI検索、マッチング、レコメンド、翻訳、分析など、中核となる体験から小さく検証します。',
  },
] as const;

const deliverables = [
  '現状業務とTo-Beの整理',
  '業務ごとのユースケース',
  '必要データ・正本・権限の定義',
  '正解例・NG例・境界例を含む評価データ',
  'AIが答える条件・人に戻す条件',
  '仕様とテストの対応関係',
  '本番システム・インフラ構成',
  '運用開始後の評価・改善ルール',
] as const;

const operations = [
  'AIモデル・APIの変更への対応',
  '検索・回答品質の定期評価',
  '文書・業務データの更新',
  '障害監視とログ確認',
  '権限・セキュリティの見直し',
  'AI利用料・インフラ費の改善',
] as const;

const pricePlans = [
  {
    title: '課題整理・要件定義',
    price: '30〜80万円程度',
    body: '業務ヒアリング、As-Is / To-Be、ユースケース、検証項目までを整理します。まず整理だけ依頼し、その結果を見て開発を見積もる進め方も可能です。',
  },
  {
    title: '小さな試作・AI PoC',
    price: '100〜200万円程度',
    body: '画面や主要なAI機能を小さく作り、方向性を確かめます。本番データや複雑な連携をほとんど含まない場合の目安です。',
  },
  {
    title: 'RAG・AI OCRなど、実データを使うPoC',
    price: '200〜500万円程度',
    body: '社内文書検索、RAG、AI OCR、評価データ作成、人の確認画面などを含む場合の目安です。',
  },
  {
    title: 'AIエージェント・複数システム連携',
    price: '300〜1,000万円程度',
    body: 'API、データベース、既存システムをまたぐ処理や、権限・承認・監査ログまで含む場合の目安です。',
  },
] as const;

const proposalExamples = [
  'GraphRAG＋AIナレッジ検索＋PDF約30ファイルの検証：2か月 / 340万円（税別）',
  'PDF＋動画文字起こしを含むPoC：2か月 / 560万円（税別）',
  '全量データを使う本格PoC・プロトタイプ：4か月 / 780万円（税別）',
] as const;

const productionCostFactors = [
  '既存システムとの連携数',
  'データ量とデータ整備',
  'RAG / GraphRAGの構成',
  'AIエージェントが実行する処理',
  '権限・監査ログ',
  '精度要件',
  'セキュリティ要件',
] as const;

const faq = [
  {
    question: 'まだ何を作るか決まっていなくても相談できますか？',
    answer:
      'できます。最初に、どの業務のどの作業を減らしたいかを整理し、作り方が分かっている部分と、試さないと分からない部分を分けます。',
  },
  {
    question: '生成AI開発の不確実性は、どうやって減らしますか？',
    answer:
      '作り方が分かっていること、実物を見れば決められること、実際に試さないと分からないことの3つに分けます。最後の部分だけ、正解例・NG例・境界例と合格条件を決めてPoCし、Go / No-Goを判断します。',
  },
  {
    question: 'なぜ最初から全部PoCしないのですか？',
    answer:
      '画面、権限、業務フローなど、すでに作り方が分かっている部分まで検証すると時間と費用が増えるからです。不確実なところだけを検証します。',
  },
  {
    question: 'RAGとは何ですか？',
    answer:
      'RAGは、社内文書やFAQを検索し、その内容を根拠に生成AIへ回答させる仕組みです。Embedding、ベクトルDB、Reranking、GraphRAG、評価設計まで対応します。',
  },
  {
    question: 'GraphRAGは、どんなときに使いますか？',
    answer:
      '似た文章を探すだけでは答えにくく、複数の情報の関係をたどる必要がある場合に検討します。通常RAGで必要な品質に届くなら、構成を複雑にしません。',
  },
  {
    question: 'AIエージェントも開発できますか？',
    answer:
      'できます。API、データベース、社内システムを呼び分けて仕事を進めるAIエージェントを設計・実装します。MCP、Function Callingにも対応します。',
  },
  {
    question: '社外秘データや個人情報は扱えますか？',
    answer:
      '扱えます。利用するAI・クラウド、データの保存場所、権限、マスキング、監査ログなどを要件に合わせて設計します。',
  },
] as const;
---

<Layout title={title} description={description} canonical={serviceUrl}>
  <JsonLd
    slot="head"
    type="service"
    data={{
      serviceName: '生成AI受託開発',
      serviceDescription: description,
      url: serviceUrl,
      serviceType: '生成AI受託開発',
      image: `${siteUrl}/og-image.png`,
    }}
  />
  <JsonLd
    slot="head"
    type="breadcrumb"
    data={{
      items: [
        { name: 'ホーム', url: '/' },
        { name: '生成AI受託開発', url: '/services/ai-development' },
      ],
    }}
  />
  <JsonLd
    slot="head"
    type="faq"
    data={{ faqs: faq.map((item) => ({ question: item.question, answer: item.answer })) }}
  />

  <Header />
  <main class="bg-neutral-50 pt-20">
    <section class="border-b border-neutral-200 bg-white py-20 md:py-28">
      <div class="container mx-auto max-w-6xl px-6 md:px-8">
        <p class="text-sm font-bold tracking-[0.18em] text-primary-600">GENERATIVE AI DEVELOPMENT</p>
        <h1 class="mt-5 max-w-5xl text-4xl font-bold leading-tight text-navy-950 md:text-6xl">
          AIで減らす仕事を決め、<br class="hidden md:block" />試すべきところだけPoCで確かめます
        </h1>
        <p class="mt-7 max-w-4xl text-lg leading-relaxed text-neutral-700 md:text-xl">
          生成AIは、作ること自体は以前より速くなりました。難しいのは、実データで期待どおり動くか、業務の中で本当に使えるかを事前に読み切れないことです。
        </p>
        <p class="mt-4 max-w-4xl text-lg leading-relaxed text-neutral-700 md:text-xl">
          Beekleは、<strong class="text-navy-950">分かっている部分は早く作り、分からない部分だけを評価してから本番へ進めます。</strong>
        </p>
        <div class="mt-10 flex flex-col gap-3 sm:flex-row">
          <a
            href="/contact?source=services-ai-development-hero&intent=ai-development"
            data-cta-source="services-ai-development-hero"
            data-cta-id="contact"
            class="inline-flex min-h-[54px] items-center justify-center bg-primary-500 px-7 py-4 text-center text-base font-bold text-white transition-colors hover:bg-primary-600"
          >
            自社のAI活用を相談する →
          </a>
          <a
            href="/downloads/beekle-zero-start-sales-deck.pdf"
            download="beekle-zero-start-sales-deck.pdf"
            data-cta-source="services-ai-development-hero"
            data-cta-id="pdf-zero-start-sales-deck"
            class="inline-flex min-h-[54px] items-center justify-center border border-neutral-300 bg-white px-7 py-4 text-center text-base font-bold text-navy-950 transition-colors hover:bg-neutral-100"
          >
            サービス資料を見る
          </a>
        </div>
        <div class="mt-12 grid border-y border-neutral-200 sm:grid-cols-2 lg:grid-cols-4">
          {['業務整理から対応', '不確実な部分だけPoC', 'RAG / GraphRAG / AIエージェント', '評価・権限・運用まで本番化'].map((item) => (
            <div class="border-b border-neutral-200 px-5 py-5 font-semibold text-neutral-800 last:border-b-0 sm:border-r sm:last:border-r-0 lg:border-b-0">
              {item}
            </div>
          ))}
        </div>
      </div>
    </section>

    <Section variant="white" padding="lg" decoration="none">
      <div class="mx-auto max-w-6xl">
        <SectionHeader
          label="STARTING POINT"
          title="まず、どの仕事を減らしたいかを決めます"
          subtitle="AIの種類ではなく、現場の仕事から考えます"
        />
        <div class="grid gap-5 md:grid-cols-2">
          {painPoints.map((item) => (
            <article class="border border-neutral-200 bg-white p-6 md:p-8">
              <h3 class="text-xl font-bold leading-snug text-navy-950">{item.title}</h3>
              <p class="mt-4 leading-relaxed text-neutral-700">{item.body}</p>
            </article>
          ))}
        </div>
      </div>
    </Section>

    <Section variant="light" padding="lg" decoration="none">
      <div class="mx-auto max-w-5xl">
        <SectionHeader
          label="WHY NOW"
          title="実装が速くなったからこそ、何を検証するかが重要です"
          subtitle="生成AIは、作る前に結果を完全には決められません"
        />
        <div class="space-y-6 text-lg leading-relaxed text-neutral-700">
          <p>
            画面や権限、データ保存のように、作り方が分かっている部分は普通のシステム開発と同じように要件へ落とせます。
          </p>
          <p>
            一方、社内文書から必要な情報を拾えるか、OCRが帳票の揺れに耐えられるか、AIの判断をどこまで任せられるかは、<strong class="text-navy-950">実際のデータで試さないと分からない</strong>ことがあります。
          </p>
          <div class="border-l-4 border-primary-500 bg-white p-6 md:p-8">
            <p class="text-xl font-bold leading-relaxed text-navy-950 md:text-2xl">
              すべてをPoCにするのではなく、分からないところだけを検証する。
            </p>
            <p class="mt-3 leading-relaxed text-neutral-700">
              それ以外は早く形にした方が、時間も予算も無駄になりません。
            </p>
          </div>
        </div>
      </div>
    </Section>

    <Section variant="white" padding="lg" decoration="none">
      <div class="mx-auto max-w-6xl">
        <SectionHeader
          label="UNCERTAINTY"
          title="不確実性は、3つに分けると扱えます"
          subtitle="分からないことを全部まとめて「PoC」にしません"
        />
        <div class="grid gap-5 lg:grid-cols-3">
          {uncertaintyTypes.map((item) => (
            <article class="border border-neutral-200 bg-white p-6 md:p-8">
              <p class="text-sm font-bold text-primary-600">{item.label}</p>
              <h3 class="mt-2 text-xl font-bold leading-snug text-navy-950">{item.title}</h3>
              <p class="mt-4 text-sm leading-relaxed text-neutral-600">例：{item.examples}</p>
              <p class="mt-5 border-t border-neutral-200 pt-5 font-semibold leading-relaxed text-neutral-800">
                {item.action}
              </p>
            </article>
          ))}
        </div>
      </div>
    </Section>

    <Section variant="light" padding="lg" decoration="none">
      <div class="mx-auto max-w-6xl">
        <SectionHeader
          label="HOW TO REDUCE UNCERTAINTY"
          title="PoCでは、先に合格条件を決めてから試します"
          subtitle="精度が高そう、ではなく、本番へ進む条件を決めます"
        />
        <div class="grid gap-0 border border-neutral-300 bg-white md:grid-cols-5">
          {uncertaintyResolution.map(([number, title, body]) => (
            <div class="border-b border-neutral-300 p-5 last:border-b-0 md:border-r md:border-b-0 md:last:border-r-0">
              <p class="text-sm font-bold text-primary-600">STEP {number}</p>
              <h3 class="mt-2 font-bold text-navy-950">{title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-neutral-600">{body}</p>
            </div>
          ))}
        </div>
        <div class="mx-auto mt-10 max-w-4xl text-lg leading-relaxed text-neutral-700">
          <p>
            本番で新しい失敗が見つかったら、その例を評価データへ戻します。生成AIは一度のPoCで「完成」にするのではなく、<strong class="text-navy-950">失敗例を蓄積しながら、判断できる範囲を広げる</strong>方が運用しやすくなります。
          </p>
        </div>
      </div>
    </Section>

    <Section variant="white" padding="lg" decoration="none">
      <div class="mx-auto max-w-6xl">
        <SectionHeader
          label="WHY BEEKLE"
          title="業務の話を、データ・AI・テストまでつなげます"
          subtitle="上流の整理と実装を別々にせず、同じ流れで設計します"
        />
        <div class="grid gap-0 border border-neutral-300 bg-neutral-50 md:grid-cols-6">
          {buildFlow.map(([title, detail]) => (
            <div class="border-b border-neutral-300 p-5 last:border-b-0 md:border-r md:border-b-0 md:last:border-r-0">
              <h3 class="font-bold text-navy-950">{title}</h3>
              <p class="mt-2 text-xs leading-relaxed text-neutral-600">{detail}</p>
            </div>
          ))}
        </div>
        <div class="mx-auto mt-10 max-w-4xl space-y-5 text-lg leading-relaxed text-neutral-700">
          <p>
            「AIを入れたい」をそのまま仕様にはしません。誰が、どの場面で、何をできれば仕事が変わるのかをユースケースにし、必要なデータ、権限、AIの判断範囲、評価条件へ落とします。
          </p>
          <p>
            仕様が変わったときも、どの実装とテストを見直すか追えるようにします。自社開発のPM on Railsも、この進め方をAIエージェントで支援するために作っています。
          </p>
        </div>
      </div>
    </Section>

    <Section variant="light" padding="lg" decoration="none">
      <div class="mx-auto max-w-6xl">
        <SectionHeader label="PROOF" title="実物を早く出し、数字で判断してきました" />
        <div class="grid gap-5 lg:grid-cols-3">
          {proofs.map((item) => (
