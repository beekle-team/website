---
import { AskAiButton } from '@/components/ask-ai-button';
import { AskAiSection } from '@/components/ask-ai-section';
import { Header } from '@/components/header';
import JsonLd from '@/components/seo/json-ld.astro';
import ServiceCaseStudies from '@/components/services/service-case-studies.astro';
import ServiceFaq from '@/components/services/service-faq.astro';
import ServiceHero from '@/components/services/service-hero.astro';
import ServiceRagDeploymentModes from '@/components/services/service-rag-deployment-modes.astro';
import { Section, SectionHeader } from '@/components/ui';
import {
  ragAcceptanceChecks,
  ragDeliveryItems,
  ragInvestmentPhases,
  ragService,
  ragServicePageConfig,
  ragUncertaintyTypes,
  ragUseCases,
} from '@/data/rag-service-page';
import Layout from '../../layouts/layout.astro';

export const prerender = false;

const service = ragService;
const siteUrl = 'https://beekle.jp';
const serviceUrl = `${siteUrl}/services/rag-system-development`;
const seoTitle = service.seoTitle ?? service.title;
const seoDescription = service.seoDescription ?? service.description;

const heroConfig = ragServicePageConfig;
const whyBeekle = ragServicePageConfig.rtb;

const relatedGuides = [
  {
    href: '/column/genai-introduction-complete-guide',
    title: '生成AI導入の進め方と投資判断を知る',
    description: '不確実性の切り分け、PoCの判断基準、本番導入までの考え方を解説します。',
  },
  {
    href: '/column/what-is-rag',
    title: 'RAGの仕組みと向いている業務を知る',
    description: 'RAGが自社の課題に合うか判断するための基礎をまとめています。',
  },
  {
    href: '/column/ai-rag-accuracy-graphrag',
    title: 'RAGの回答精度と評価方法を知る',
    description: '業務で使える精度をどう測り、どこを改善するかを解説しています。',
  },
  {
    href: '/knowledge/graphrag-knowledge-search',
    title: 'Hybrid GraphRAGの実装を見る',
    description: 'ベクトル検索・全文検索・グラフ検索を組み合わせたBeekleの実装例です。',
  },
  {
    href: '/column/eliminate-work-attribution',
    title: '属人化した知識を引き継ぐ方法を知る',
    description: '特定の担当者に知識が集中している状態をどう解消するかを整理しています。',
  },
] as const;
---

<Layout title={`${seoTitle} | Beekle`} description={seoDescription} canonical={serviceUrl}>
  <JsonLd
    slot="head"
    type="service"
    data={{
      serviceName: service.title,
      serviceDescription: service.description,
      url: serviceUrl,
      serviceType: service.title,
      image: `${siteUrl}/og-image.png`,
    }}
  />
  <JsonLd
    slot="head"
    type="breadcrumb"
    data={{
      items: [
        { name: 'ホーム', url: '/' },
        { name: service.title, url: '/services/rag-system-development' },
      ],
    }}
  />
  <JsonLd
    slot="head"
    type="faq"
    data={{ faqs: service.faq.map((faq) => ({ question: faq.question, answer: faq.answer })) }}
  />

  <Header />
  <main class="bg-neutral-100 pt-20">
    <ServiceHero service={service} config={heroConfig} />

    <Section id="use-cases" variant="light" padding="md" decoration="none">
      <div class="mx-auto max-w-6xl">
        <SectionHeader
          label="USE CASES"
          title="探す・聞く・読み比べる時間を、次の判断に使う"
          subtitle="同じ製品情報でも、営業・技術・サポートで必要な答えは違います"
        />
        <p class="mx-auto max-w-4xl text-lg leading-relaxed text-neutral-700">
          RAGは、自社の資料や業務データを検索し、その根拠を使ってAIが回答する仕組みです。情報同士の関係をたどる必要があればGraphRAGも組み合わせ、たとえば次のような業務での活用を設計します。
        </p>
        <div class="mt-10 grid border border-neutral-300 bg-white md:grid-cols-3">
          {ragUseCases.map((item) => (
            <article class="min-w-0 border-b border-neutral-300 p-6 last:border-0 md:border-r md:border-b-0 md:p-8">
              <p class="text-sm font-bold text-primary-600">{item.role}</p>
              <h3 class="mt-3 text-xl font-bold leading-relaxed text-navy-950">「{item.question}」</h3>
              <p class="mt-5 leading-relaxed text-neutral-700">{item.answer}</p>
              <p class="mt-6 border-t border-neutral-200 pt-5 font-bold leading-relaxed text-navy-950">{item.outcome}</p>
            </article>
          ))}
        </div>
        <p class="mt-6 leading-relaxed text-neutral-700">
          最初は、繰り返し発生し、根拠となる資料やデータがある業務を一つ選びます。判断の根拠が担当者の頭の中にしかなければ、ヒアリングで知識を整理するところから始めます。
        </p>
      </div>
    </Section>

    <Section id="why-now" variant="white" padding="lg" decoration="none">
      <div class="mx-auto max-w-6xl">
        <SectionHeader
          label="WHY NOW"
          title="なぜ今投資に値するか"
          subtitle="社内ナレッジは、検索改善だけでなく、人件費・教育・判断品質・AI活用に大きな貢献ができます。"
        />

        <div class="mx-auto max-w-4xl space-y-6 text-lg leading-relaxed text-neutral-700">
          <p>
            例えば、「前にも同じ案件があったはず」と資料を探すことがありますよね。分からないので詳しい人を探します。質問を送って返事を待つとしましょう。新人に、前にも誰かに説明した内容をもう一度教える。こうした時間は、一つひとつは小さくても、毎日何人もの社員が繰り返せば大きな人件費になります。
          </p>
          <p>
            しかも止まるのは、質問する側だけではありません。<strong class="text-navy-950">聞かれる側の時間も同時に使われます。</strong>知識が人に集中している会社ほど、詳しい人ほど本来の仕事に集中しにくくなります。
          </p>
        </div>

        <div class="mx-auto mt-12 grid max-w-6xl gap-6 md:grid-cols-2">
          <article class="border border-neutral-200 bg-neutral-50 p-6 md:p-8">
            <h3 class="text-xl font-bold text-navy-950">専門家の時間を、本来の仕事へ戻せる</h3>
            <p class="mt-4 leading-relaxed text-neutral-700">
              製品に詳しい人、過去案件を知る人、社内ルールを知る人には質問が集まります。利用者が社内の知識から自分で答えを探せれば、詳しい人は例外判断、設計、改善、顧客対応など経験が必要な仕事へ時間を使えます。
            </p>
          </article>
          <article class="border border-neutral-200 bg-neutral-50 p-6 md:p-8">
            <h3 class="text-xl font-bold text-navy-950">新人が自分で調べられる範囲を増やせる</h3>
            <p class="mt-4 leading-relaxed text-neutral-700">
              資料の場所や基本ルールを毎回教えるのではなく、回答と根拠を自分で確認できるようにします。教育をなくすのではなく、同じ説明を繰り返す時間を減らし、判断が必要な部分の教育に時間を使えます。
            </p>
          </article>
          <article class="border border-neutral-200 bg-neutral-50 p-6 md:p-8">
            <h3 class="text-xl font-bold text-navy-950">過去の失敗や判断を、次の仕事で使える</h3>
            <p class="mt-4 leading-relaxed text-neutral-700">
              過去の設計、問い合わせ、トラブル、顧客ごとの情報を探せれば、同じ判断をゼロからやり直す必要がありません。時短だけでなく、見落としや手戻りを減らし、判断の質を上げることにもつながります。
            </p>
          </article>
          <article class="border border-neutral-200 bg-neutral-50 p-6 md:p-8">
            <h3 class="text-xl font-bold text-navy-950">生成AIに任せられる仕事を増やせる</h3>
            <p class="mt-4 leading-relaxed text-neutral-700">
              ChatGPTやClaudeは、自社の製品、顧客、規程、過去対応の知識がモデルに入っているわけではありません。社内の知識をAIから使えるようにして初めて、自社固有の問い合わせや判断支援まで自動化しやすくなります。
            </p>
          </article>
        </div>

        <div class="mx-auto mt-12 max-w-5xl border-y border-neutral-300 py-8">
          <p class="text-sm font-bold text-primary-600">実際の導入事例でも、利益は「検索が便利になった」で終わっていません</p>
          <div class="mt-5 grid gap-6 md:grid-cols-3">
            <div>
              <h3 class="font-bold text-navy-950">NTTデータ</h3>
              <p class="mt-2 text-sm leading-relaxed text-neutral-700">
                社内ポータルやFAQを生成AIから検索できるようにし、社内調査では平均で約60分/週の時間削減につながっています。
              </p>
              <a
                href="https://www.nttdata.com/jp/ja/trends/data-insight/blog/bizxaas-office/2025/0106/"
                target="_blank"
                rel="noopener noreferrer"
                class="mt-3 inline-flex text-sm font-bold text-primary-600 hover:text-primary-700"
              >
                事例を見る →
              </a>
            </div>
            <div>
              <h3 class="font-bold text-navy-950">デンソー</h3>
              <p class="mt-2 text-sm leading-relaxed text-neutral-700">
                過去の設計情報を生成AIから探せるようにし、これまで気づかなかった注意点を過去データから拾うなど、設計品質の向上にもつなげています。
              </p>
              <a
                href="https://www.microsoft.com/ja-jp/customers/story/19426-denso-corporation-microsoft-365-copilot"
                target="_blank"
                rel="noopener noreferrer"
                class="mt-3 inline-flex text-sm font-bold text-primary-600 hover:text-primary-700"
              >
                事例を見る →
              </a>
            </div>
            <div>
              <h3 class="font-bold text-navy-950">日本製鉄</h3>
              <p class="mt-2 text-sm leading-relaxed text-neutral-700">
                4,400人への展開後、1か月で社内ファイル検索に5万回以上使われています。次のテーマとして、ベテランの暗黙知の活用にも取り組んでいます。
              </p>
              <a
                href="https://www.microsoft.com/ja-jp/customers/story/23624-nippon-steel-corporation-microsoft-365-copilot"
                target="_blank"
                rel="noopener noreferrer"
                class="mt-3 inline-flex text-sm font-bold text-primary-600 hover:text-primary-700"
              >
                事例を見る →
              </a>
            </div>
          </div>
        </div>

        <div class="mx-auto mt-12 max-w-4xl border-l-4 border-primary-500 pl-6">
          <h3 class="text-2xl font-bold leading-snug text-navy-950">
            社内ナレッジへの投資は、資料を探しやすくするためだけのものではありません
          </h3>
          <p class="mt-4 text-lg leading-relaxed text-neutral-700">
            減らせるのは、探す時間、聞く時間、回答を待つ時間、同じことを教える時間、過去と同じ検討をやり直す時間です。その分、専門家は本来の仕事に集中でき、新人は早く自分で動けるようになり、過去の知識を次の仕事に使えます。さらに、生成AIに任せられる仕事の範囲も広げられます。
          </p>
        </div>
      </div>
    </Section>

    <Section id="why-beekle" variant="light" padding="md" decoration="none">
      <div class="mx-auto max-w-6xl">
        <SectionHeader
          label="WHY BEEKLE"
          title={whyBeekle.title}
          subtitle="現場から要件を作り、必要な検証を絞り、本番で使うところまで担います"
        />
        <p class="mx-auto max-w-4xl text-lg leading-relaxed text-neutral-700">{whyBeekle.lead}</p>
        <div class="mt-10 divide-y divide-neutral-300 border-y border-neutral-300">
          {whyBeekle.items.map((item, index) => (
            <article class="py-8 md:py-10">
              <div class="grid gap-5 lg:grid-cols-[1fr_2fr] lg:gap-12">
                <div>
                  <p class="font-Poppins text-sm font-bold text-primary-600">{String(index + 1).padStart(2, '0')}</p>
                  <h3 class="mt-3 text-xl font-bold leading-relaxed text-navy-950 md:text-2xl">{item.title}</h3>
                </div>
                <div>
                  <p class="leading-relaxed text-neutral-700">{item.description}</p>
                  {item.id === 'uncertainty' && (
                    <dl class="mt-5 divide-y divide-neutral-200 border border-neutral-300 bg-white px-5">
                      {ragUncertaintyTypes.map((type) => (
                        <div class="py-4">
                          <dt class="font-bold text-navy-950">{type.title}</dt>
                          <dd class="mt-1 text-sm leading-relaxed text-neutral-700">{type.example}</dd>
                          <dd class="mt-2 text-sm font-bold leading-relaxed text-primary-700">→ {type.action}</dd>
                        </div>
                      ))}
                    </dl>
                  )}
                  <p class="mt-4 leading-relaxed text-neutral-700">{item.detail}</p>
                  <p class="mt-5 border-l-4 border-primary-500 pl-4 font-bold leading-relaxed text-navy-950">{item.benefit}</p>
                  {item.id === 'delivery' && (
                    <a href="https://pmonrails.com/" target="_blank" rel="noopener noreferrer" class="mt-3 inline-flex min-h-[44px] items-center py-2 text-sm font-bold text-primary-600 underline underline-offset-4 hover:text-primary-700">
                      PM on Railsの仕組みを見る →
                    </a>
                  )}
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </Section>

    <ServiceCaseStudies
      caseStudies={service.caseStudies}
      number=""
      title="実データで確かめ、検索方式と本番の仕組みを作ってきました"
      subtitle="Beekleが担当したRAG・GraphRAGの構築事例です"
    />

    <Section id="pricing" variant="white" padding="md" decoration="none">
      <div class="mx-auto max-w-6xl">
        <SectionHeader
          label="PLAN & PRICING"
          title="本開発への投資は、自社データの結果を見て決める"
          subtitle="検証・本番開発・運用を分けて、範囲と費用を提示します"
        />
        <div class="mx-auto max-w-4xl space-y-4 text-lg leading-relaxed text-neutral-700">
          <p>
            最初の相談では、減らしたい業務、実際に聞きたい質問、資料のサンプル、今使っているシステムを伺います。整理できていない項目があっても構いません。確認すべきことを一緒に洗い出します。
          </p>
          <p>
            検証を始める前に、現場の担当者と<strong class="text-navy-950">正解例・NG例・境界例と、本番へ進むための合格条件</strong>を決めます。評価するのは、回答の精度だけではありません。
          </p>
        </div>
        <div class="mt-8 grid gap-6 md:grid-cols-3">
          {ragAcceptanceChecks.map((item) => (
            <article class="border-t-2 border-primary-500 pt-5">
              <h3 class="text-lg font-bold text-navy-950">{item.title}</h3>
              <p class="mt-3 leading-relaxed text-neutral-700">{item.description}</p>
            </article>
          ))}
        </div>
        <div class="mt-8 border-l-4 border-primary-500 bg-white p-6">
          <h3 class="text-xl font-bold leading-relaxed text-navy-950">条件に届かなければ、そのまま本開発へは進みません</h3>
          <p class="mt-3 leading-relaxed text-neutral-700">
            用途を狭める、人の確認を残す、データや検索方式を見直す。費用対効果が合わなければ、導入を見送る判断もします。PoCで揃えるのは、次の投資をするか・しないかを決める材料です。
          </p>
        </div>
        <h3 class="mt-12 text-2xl font-bold text-navy-950">RAG構築の費用目安と、各段階で確認できること</h3>
        <div class="mt-6 divide-y divide-neutral-300 border border-neutral-300 bg-white">
          {ragInvestmentPhases.map((item) => (
            <article class="grid gap-5 p-6 lg:grid-cols-[0.85fr_1.15fr_1.3fr] lg:gap-8 md:p-8">
              <div>
                <h4 class="text-lg font-bold text-navy-950">{item.phase}</h4>
                <p class="mt-2 text-xl font-bold text-primary-700">{item.price}</p>
                <p class="mt-3 text-sm leading-relaxed text-neutral-700">{item.scope}</p>
              </div>
              <div>
                <p class="text-sm font-bold text-neutral-600">受け取るもの</p>
                <p class="mt-2 leading-relaxed text-neutral-700">{item.deliverable}</p>
              </div>
              <div>
                <p class="text-sm font-bold text-neutral-600">次へ進む判断・見直すこと</p>
                <p class="mt-2 leading-relaxed text-neutral-700">{item.decision}</p>
              </div>
            </article>
          ))}
        </div>
        <p class="mt-4 text-sm leading-relaxed text-neutral-600">
          対象データ、連携先、権限、評価範囲によって費用は変わります。初回相談後に、検証が必要な範囲と本番開発を分け、内訳を提示します。
        </p>
        <a
          href="/contact?source=services-rag-system-development-pricing&intent=rag-system-development"
          data-cta-source="services-rag-system-development-pricing"
          data-cta-id="contact-rag-system-development"
          class="mt-6 inline-flex min-h-[52px] w-full items-center justify-center rounded-md bg-primary-500 px-6 py-3 text-center font-bold leading-relaxed text-white transition-colors hover:bg-primary-600 sm:w-auto"
        >
          検証する範囲と概算費用を相談する →
        </a>
      </div>
    </Section>

    <Section id="delivery-operations" variant="light" padding="md" decoration="none">
      <div class="mx-auto max-w-6xl">
        <SectionHeader
          label="DELIVERY & OPERATIONS"
          title="業務画面も、運用を続けるための設計も残します"
          subtitle="依頼範囲に応じて、設計・システム・評価結果・運用手順を納品します"
        />
        <dl class="divide-y divide-neutral-300 border-y border-neutral-300">
          {ragDeliveryItems.map((item) => (
            <div class="grid gap-3 py-6 md:grid-cols-[1fr_2fr] md:gap-8">
              <dt class="text-lg font-bold text-navy-950">{item.scope}</dt>
              <dd class="leading-relaxed text-neutral-700">{item.deliverables}</dd>
            </div>
          ))}
        </dl>
        <div class="mt-10 border border-neutral-300 bg-white p-6 md:p-8">
          <h3 class="text-xl font-bold leading-relaxed text-navy-950 md:text-2xl">運用で見つかった失敗を、次の評価に戻す</h3>
          <p class="mt-4 leading-relaxed text-neutral-700">
            新しい質問に答えられない、資料の更新で回答が変わる、費用が想定を超える。こうした変化をログから拾い、原因をデータ・検索・回答ルールに分けて改善します。
          </p>
          <ol class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
            {['失敗例をログから集める', '評価データに追加する', '原因を直して再評価する', 'AIに任せる範囲を見直す'].map((step, index) => (
              <li class="flex gap-3 border-t border-neutral-300 pt-4 font-bold leading-relaxed text-navy-950">
                <span class="font-Poppins text-primary-600">{index + 1}</span><span>{step}</span>
              </li>
            ))}
          </ol>
          <p class="mt-6 leading-relaxed text-neutral-700">
            文書の追加・更新・削除、権限の見直し、モデル変更、インフラ監視・障害対応、AI利用料の監視も運用範囲として整理します。品質と費用を確認しながら、効果のある業務へ段階的に広げます。
          </p>
        </div>
      </div>
    </Section>

    <Section id="rag-or-graphrag" variant="light" padding="lg" decoration="none">
      <div class="mx-auto max-w-6xl">
        <SectionHeader
          label="ARCHITECTURE"
          title="必要以上に複雑なRAGを作らず、質問に合う検索方式を選びます"
          subtitle="GraphRAGありきではなく、必要な品質を合理的な構成で出すことを優先します"
        />
        <div class="grid gap-6 lg:grid-cols-2">
          <article class="border border-neutral-200 bg-white p-6 md:p-8">
            <p class="text-sm font-bold text-primary-600">通常のRAGが向く質問</p>
            <h3 class="mt-2 text-xl font-bold text-navy-950">答えが主に一つの文書・箇所にある</h3>
            <div class="mt-6 flex flex-wrap items-center gap-2 text-sm font-bold text-neutral-800">
              <span class="border border-neutral-200 bg-neutral-50 px-3 py-2">質問</span>
              <span>→</span>
              <span class="border border-neutral-200 bg-neutral-50 px-3 py-2">関係文書を検索</span>
              <span>→</span>
              <span class="border border-neutral-200 bg-neutral-50 px-3 py-2">根拠付き回答</span>
            </div>
            <p class="mt-5 leading-relaxed text-neutral-700">
              規程の確認、マニュアル検索、FAQなどは、通常RAGや全文検索との組み合わせで十分なことがあります。
            </p>
          </article>
          <article class="border border-primary-200 bg-white p-6 md:p-8">
            <p class="text-sm font-bold text-primary-600">GraphRAGが候補になる質問</p>
            <h3 class="mt-2 text-xl font-bold text-navy-950">複数の情報の関係をたどる必要がある</h3>
            <div class="mt-6 flex flex-wrap items-center gap-2 text-sm font-bold text-neutral-800">
              <span class="border border-neutral-200 bg-neutral-50 px-3 py-2">製品</span>
              <span>→</span>
