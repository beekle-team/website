---
import InformationMap from '@/components/services/information-map.astro';
import { SectionHeader } from '@/components/ui';
import type { ServiceDetail } from '@/types/service';
interface Props {
  features: ServiceDetail['features'];
  number?: string;
  title?: string;
  subtitle?: string;
}
const {
  features,
  number = '04',
  title = 'Beekleが対応できる開発領域',
  subtitle = '技術選定から運用まで、必要な範囲をまとめて引き受けます',
} = Astro.props;
---
<section id="features" class="relative bg-neutral-50 py-16 md:py-20">
  <div class="container mx-auto px-6 lg:px-12">
    <SectionHeader title={title} subtitle={subtitle} number={number} />
    <InformationMap label="対応する開発領域" items={features} caption="対応できる開発領域を整理した図です。すべてを一度に作るのではなく、合意した範囲から実装します。" />
  </div>
</section>
