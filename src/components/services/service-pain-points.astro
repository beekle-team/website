---
import InformationMap from '@/components/services/information-map.astro';
import { SectionHeader } from '@/components/ui';
import ReadingVisual from '@/components/visuals/reading-visual.astro';
import { serviceReadingVisuals } from '@/data/service-reading-visuals';
import type { ServiceDetail } from '@/types/service';
interface Props {
  painPoints: ServiceDetail['painPoints'];
  number?: string;
  title?: string;
  subtitle?: string;
}
const {
  painPoints,
  number = '01',
  title = 'こんな状態になっていませんか',
  subtitle = 'いまの業務で困っていることを確認します',
} = Astro.props;
const visualName =
  serviceReadingVisuals[Astro.url.pathname.split('/').filter(Boolean).pop() ?? '']?.pain;
---
<section id="pain-points" class="relative bg-neutral-50 py-16 md:py-20">
  <div class="container mx-auto px-6 lg:px-12">
    <SectionHeader title={title} subtitle={subtitle} number={number} />
    {visualName ? <>
      <ReadingVisual name={visualName} />
      <div class="mx-auto mt-6 max-w-4xl rounded-lg border border-neutral-300 bg-white p-5 md:p-6">
        <h3 class="py-2 text-lg font-bold text-accent-950">課題と確認項目</h3>
        <div class="mt-6"><InformationMap label="確認する課題" items={painPoints} caption="現状の課題を整理した図です。該当する業務と、発生する頻度・確認にかかる手間を相談時に確認します。" /></div>
      </div>
    </> : <InformationMap label="確認する課題" items={painPoints} caption="現状の課題を整理した図です。該当する業務と、発生する頻度・確認にかかる手間を相談時に確認します。" />}

  </div>
</section>
