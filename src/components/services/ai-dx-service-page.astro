    answer:
      mode === 'management-dx'
        ? 'できます。開発発注を前提に検討する案件でも、検証結果から見送る判断ができます。検証範囲と費用条件は着手前に合意します。壁打ちや月額支援の実施分は、本番化の有無にかかわらず有料です。'
        : 'できます。検証用デモを触って、精度、業務適合、利用者、データ、運用負荷を確認します。進めない場合は費用はかからず、見送り理由と再検討条件を残します。',
  },
];
---

<Layout title={`${page.seoTitle} | Beekle`} description={page.seoDescription} canonical={pageUrl}>
  <JsonLd
    slot="head"
    type="service"
    data={{
      serviceName: page.serviceName,
      serviceDescription: page.seoDescription,
      url: pageUrl,
      serviceType: page.serviceType,
      image: `${siteUrl}/og-image.png`,
    }}
  />
  <JsonLd
    slot="head"
    type="breadcrumb"
    data={{
      items: [
        { name: 'ホーム', url: '/' },
        { name: page.breadcrumb, url: page.path },
      ],
    }}
  />
  <JsonLd slot="head" type="faq" data={{ faqs }} />

  <Header />

  <main class="bg-neutral-100 pt-20">
    <section class="relative overflow-hidden border-b border-neutral-300 bg-neutral-100 py-14 md:py-20">
      <div class="container relative mx-auto px-8 lg:px-12">
        <div class="grid gap-10 lg:grid-cols-[0.82fr_0.72fr] lg:items-center">
          <div class="max-w-3xl">
            <span class="mb-6 inline-block border-l-8 border-primary-500 pl-5 text-sm font-bold text-primary-700">
              {page.eyebrow}
            </span>
            <h1 class="mb-6 text-3xl font-bold leading-tight text-accent-950 sm:text-4xl lg:text-5xl">
              {page.heading}
            </h1>
            <p class="mb-8 text-lg leading-relaxed text-neutral-700 md:text-xl">{page.lead}</p>
            <p class="mb-8 border-y border-neutral-200 py-3 text-sm font-bold leading-relaxed text-accent-950">
              {page.heroNote}
            </p>
            <a
              href={contactHref}
              data-cta-source={`${page.source}-hero`}
              data-cta-id="contact"
              class="inline-flex min-h-[52px] items-center justify-center rounded-md border border-primary-500 bg-primary-500 px-6 py-3 text-center text-base font-bold leading-snug text-white transition hover:border-primary-600 hover:bg-primary-600 sm:px-8"
            >
              {page.heroCta}
              <svg class="ml-2 h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
              </svg>
            </a>
            {mode === 'management-dx' && (
              <a href="#management-dx-session" class="mt-3 inline-flex min-h-[48px] items-center px-2 py-3 text-base font-bold text-primary-700 underline underline-offset-4 hover:text-primary-600 sm:ml-4">
                90分の壁打ちプランを見る →
              </a>
            )}
          </div>

          <aside class="border-y border-neutral-300 bg-white">
            <div class="grid grid-cols-[1fr_auto] gap-4 border-b border-l-8 border-neutral-300 border-l-primary-500 px-5 py-4">
              <div>
                <p class="text-sm font-bold text-primary-700">{page.memoTitle}</p>
                <p class="mt-1 text-2xl font-bold leading-tight text-accent-950">{page.memoSubtitle}</p>
              </div>
              <p class="font-Poppins text-xs font-bold text-neutral-500">BEEKLE / AI・DX</p>
            </div>
            <dl class="divide-y divide-neutral-300">
              {page.memoRows.map(([label, value]) => (
                <div class="grid grid-cols-[112px_1fr]">
                  <dt class="border-r border-neutral-200 bg-neutral-50 px-5 py-4 text-sm font-bold text-primary-700">
                    {label}
                  </dt>
                  <dd class="px-5 py-4 text-base font-bold leading-relaxed text-accent-950">{value}</dd>
                </div>
              ))}
            </dl>
          </aside>
        </div>
      </div>
    </section>

    <section class="bg-white py-16">
      <div class="container mx-auto px-8 lg:px-12">
        <h2 class="mb-6 text-3xl font-bold leading-snug text-accent-950">{mode === 'management-dx' ? '経営データを、判断できる情報に整理する' : '業務を整理し、試してから導入を決める'}</h2>
        <ServiceFigure
          name={mode === 'management-dx' ? 'management-data-flow-v1' : 'prototype-review-v2'}
          alt={mode === 'management-dx' ? '部門の情報を集め、同じ基準で整理し、人が課題と対応を決める経営DXの流れ' : '業務の整理、デモの確認、開発範囲の合意というAI導入の流れ'}
          caption={mode === 'management-dx' ? 'Beekleの経営DX支援では、営業・会計・顧客対応などのデータを整理し、経営者が課題と対応を判断できる状態を目指します。90分の有料相談では課題と優先順位を整理します。図に示すデータ連携やシステム実装は、別途合意した支援範囲で行います。' : 'BeekleのAI導入支援では、対象業務と必要なデータを整理し、まず1業務に必要な画面と業務ロジックをデモに実装し、実際に操作して確認します。評価結果と費用を確認してから、有料のPoCや継続支援を判断します。'}
        />
      </div>
    </section>
    <Section variant="light" padding="lg">
      <SectionHeader
        title={page.issueTitle}
        subtitle={page.issueSubtitle}
        number="01"
        label="ISSUES"
      />
      {mode === 'management-dx' ? <SectionVisual name="management-priorities-v1" /> : <ReadingVisual name="ai-evaluation-before-after-v1" />}
      <div class="mx-auto grid max-w-5xl grid-cols-1 gap-6 md:grid-cols-2">
        {page.painPoints.map((pain) => (
          <article class="rounded-lg border border-neutral-200 bg-white p-6 md:p-8">
            <h2 class="mb-3 text-lg font-bold leading-snug text-navy-950 md:text-xl">{pain.title}</h2>
            <p class="text-sm leading-relaxed text-neutral-700 md:text-base">{pain.description}</p>
          </article>
        ))}
      </div>
    </Section>

    {mode === 'management-dx' && <ManagementDxEvidence />}

    <Section variant="white" padding="lg" id="plans">
      <SectionHeader
        title={mode === 'management-dx' ? '90分の壁打ちから、実装・継続支援まで' : 'デモの後に選ぶ、準委任の3つの月額プラン'}
        subtitle={mode === 'management-dx' ? '経営課題と導入方針を整理する有料コンサルティングです。単発の壁打ちから、必要に応じて顧問・伴走支援へ進めます' : 'まず0円の検証デモで判断し、進める場合に相談役だけ、伴走、専任チームのどれが要るかを選びます'}
        number="02"
        label="PLANS"
      />
      <SectionVisual name="support-roles-v1" />

      {mode === 'management-dx' && <ManagementDxSession />}

      {mode === 'ai-adoption' && (
      <aside class="mx-auto mb-8 max-w-5xl border-y border-neutral-300 bg-neutral-50 px-6 py-6 md:px-8">
        <div class="grid gap-5 md:grid-cols-[1fr_auto] md:items-center">
          <div>
            <p class="text-xs font-bold tracking-wide text-primary-700">スポット支援</p>
            <h2 class="mt-2 text-xl font-bold text-navy-950">{spotPlan.name}</h2>
            <p class="mt-2 text-sm leading-relaxed text-neutral-700">
              まず実データで使えるか確かめたい方へ。{spotPlan.deliverable}を、対象業務を絞って作ります。進めない場合の費用はありません。無料デモはBeekleへの開発発注をご検討の案件が対象です。
            </p>
            <dl class="mt-4 border-t border-neutral-200 pt-4">
              <dt class="text-sm font-bold text-primary-700">こんな方に</dt>
              <dd class="mt-2 text-base leading-relaxed text-neutral-700">{spotPlan.target}</dd>
            </dl>
          </div>
          <div class="md:text-right">
            <p>
              <span class="font-Poppins text-3xl font-bold text-navy-950">
                {spotPlan.price === '無料' ? spotPlan.price : `&yen;${spotPlan.price}`}
              </span>
              <span class="ml-1 text-sm font-medium text-neutral-600">/ {spotPlan.priceUnit}{spotPlan.price !== '無料' && '（税別）'}</span>
            </p>
            <a
              href={`/contact?source=${page.source}-plan-assess&intent=genai-adoption`}
              data-cta-source={`${page.source}-plan-assess`}
              data-cta-id="contact"
              class="mt-4 inline-flex min-h-[48px] items-center justify-center rounded-md border border-primary-500 px-5 py-3 text-sm font-bold text-primary-600 transition hover:bg-primary-50"
            >
              無料検証を相談する
            </a>
          </div>
        </div>
      </aside>
      )}

      {mode === 'ai-adoption' && <p class="mx-auto mb-8 max-w-5xl text-base leading-relaxed text-neutral-700">{ZERO_START_SCOPE_RULE}</p>}
      <div class="space-y-6 md:hidden">
        {plans.map((plan) => (
          <article
            class:list={[
              'rounded-lg border bg-white p-6',
              plan.featured ? 'border-primary-300' : 'border-neutral-200',
            ]}
          >
            <div class="mb-2 flex items-baseline gap-3">
              <span class="font-Poppins text-3xl font-bold text-primary-500">{plan.no}</span>
              <span class="text-xs font-semibold uppercase tracking-wide text-primary-500">{plan.code}</span>
            </div>
            <h2 class="mb-2 text-xl font-bold text-navy-950">{plan.name}</h2>
            <p class="mb-4 text-sm leading-relaxed text-neutral-700">{plan.tagline}</p>
            <p class="mb-5">
              <span class="font-Poppins text-3xl font-bold text-navy-950">&yen;{plan.price}</span>
              <span class="ml-1 text-sm font-medium text-neutral-600">/ {plan.priceUnit}（税別）</span>
            </p>
            <dl class="space-y-3 border-t border-neutral-200 pt-4">
              {comparisonRows.map((row) => (
                <div>
                  <dt class="text-xs font-bold text-primary-700">{row.label}</dt>
                  <dd class="text-sm leading-relaxed text-neutral-700">{plan[row.key]}</dd>
                </div>
              ))}
            </dl>
            <a
              href={`/contact?source=${page.source}-plan-${plan.no}&intent=genai-adoption`}
              data-cta-source={`${page.source}-plan-${plan.no}`}
              data-cta-id="contact"
              class="mt-6 inline-flex min-h-[52px] w-full items-center justify-center rounded-md bg-primary-500 px-6 py-3 text-base font-bold text-white transition hover:bg-primary-600"
            >
              このプランを相談する
            </a>
          </article>
        ))}
      </div>

      <div class="mx-auto hidden max-w-6xl md:block">
        <table class="w-full border-separate border-spacing-x-3">
          <caption class="sr-only">AI導入・経営DX支援3プランの比較表</caption>
          <thead>
            <tr>
              <th scope="col" class="w-40"><span class="sr-only">項目</span></th>
              {plans.map((plan) => (
                <th scope="col" class="p-0 align-bottom">
                  <div
                    class:list={[
                      'rounded-t-lg border-x border-t bg-white px-6 pt-8 pb-6 text-left',
                      plan.featured ? 'border-primary-300' : 'border-neutral-200',
                    ]}
                  >
                    <div class="mb-2 flex items-baseline gap-3">
                      <span class="font-Poppins text-4xl font-bold text-primary-500">{plan.no}</span>
                      <span class="text-xs font-semibold uppercase tracking-wide text-primary-500">{plan.code}</span>
                    </div>
                    <p class="mb-2 text-xl font-bold text-navy-950">{plan.name}</p>
                    <p class="mb-5 text-sm font-normal leading-relaxed text-neutral-700">{plan.tagline}</p>
                    <p>
                      <span class="font-Poppins text-3xl font-bold text-navy-950">&yen;{plan.price}</span>
                      <span class="ml-1 text-sm font-medium text-neutral-600">
                        / {plan.priceUnit}（税別）
                      </span>
                    </p>
                  </div>
                </th>
              ))}
            </tr>
          </thead>
          <tbody>
            {comparisonRows.map((row) => (
              <tr>
                <th scope="row" class="py-4 pr-4 text-left align-top text-sm font-bold text-primary-700">
                  {row.label}
                </th>
                {plans.map((plan) => (
                  <td
                    class:list={[
                      'border-x border-b border-neutral-100 bg-white px-6 py-4 align-top text-sm leading-relaxed text-neutral-700',
                      plan.featured ? 'border-x-primary-300' : 'border-x-neutral-200',
                    ]}
                  >
                    {plan[row.key]}
                  </td>
                ))}
              </tr>
            ))}
            <tr>
              <td></td>
              {plans.map((plan) => (
                <td
                  class:list={[
                    'rounded-b-lg border-x border-b bg-white px-6 pt-2 pb-8',
                    plan.featured ? 'border-primary-300' : 'border-neutral-200',
                  ]}
                >
                  <a
                    href={`/contact?source=${page.source}-plan-${plan.no}&intent=genai-adoption`}
                    data-cta-source={`${page.source}-plan-${plan.no}`}
                    data-cta-id="contact"
                    class="inline-flex min-h-[52px] w-full items-center justify-center rounded-md bg-primary-500 px-6 py-3 text-base font-bold text-white transition hover:bg-primary-600"
                  >
                    このプランを相談する
                  </a>
                </td>
              ))}
            </tr>
          </tbody>
        </table>
      </div>

      <div class="mx-auto mt-8 max-w-5xl border-y border-neutral-300 bg-neutral-50 px-6 py-5">
        <p class="text-sm font-bold leading-relaxed text-accent-950">
          表示価格はすべて税別です。本番開発費、クラウド・外部サービス利用料、AIモデルのAPI料金、SaaSライセンス費、出張交通費は別途見積もりです。
        </p>
        <p class="mt-2 text-sm leading-relaxed text-neutral-700">
          AI顧問に実装は含まれません。実装を含むプランの対象テーマと体制は提案時に明示し、大規模な本番開発は別途範囲と費用を合意します。
        </p>
      </div>
    </Section>

    <Section variant="light" padding="lg">
      <SectionHeader
        title="毎月の相談を、次の判断と行動に変えます"
        subtitle="AI顧問は月次メモ、実装プランは設計・検証記録・運用ルールまで残します"
        number="03"
        label="OUTPUTS"
      />
      <SectionVisual name="delivery-handoff-v1" />
      <div class="mx-auto grid max-w-5xl gap-5 md:grid-cols-2">
        {outputs.map((output) => (
          <article class="rounded-lg border border-neutral-200 bg-white p-6 md:p-8">
            <h2 class="text-xl font-bold leading-snug text-navy-950">{output.title}</h2>
            <p class="mt-3 text-sm leading-relaxed text-neutral-700 md:text-base">{output.description}</p>
          </article>
        ))}
      </div>
    </Section>

    <Section variant="white" padding="lg">
      <SectionHeader
        title="実装力は、公開デモと事例で確認できます"
        subtitle="RAG、OCR、AIエージェント、業務システムまで、必要な方式を選んで実装します"
        number="04"
        label="PROOF"
      />
      <div class="mx-auto grid max-w-5xl gap-6 md:grid-cols-2">
        <a
          href="/demos/it-advisor"
          data-cta-source={`${page.source}-demo-rag`}
          data-cta-id="demo-it-advisor"
          class="group block rounded-lg border border-neutral-200 bg-white p-6 transition hover:border-primary-300"
        >
          <p class="text-sm font-bold text-primary-700">社内資料・ナレッジ検索</p>
          <h2 class="mt-2 text-xl font-bold text-navy-950 transition group-hover:text-primary-600">
            AIナレッジ相談デモ
          </h2>
          <p class="mt-3 text-sm leading-relaxed text-neutral-700">
            社内資料を探し、根拠を示しながら回答するRAGの利用イメージを確認できます。
          </p>
          <span class="mt-4 inline-flex items-center text-sm font-bold text-primary-600">デモを試す →</span>
        </a>
        <a
          href="/case-studies"
          data-cta-source={`${page.source}-cases`}
          data-cta-id="case-studies"
          class="group block rounded-lg border border-neutral-200 bg-white p-6 transition hover:border-primary-300"
        >
          <p class="text-sm font-bold text-primary-700">導入・開発の実績</p>
          <h2 class="mt-2 text-xl font-bold text-navy-950 transition group-hover:text-primary-600">
            導入事例と対応範囲
          </h2>
          <p class="mt-3 text-sm leading-relaxed text-neutral-700">
            AI検索、業務システム、データ基盤など、課題から実装・運用までの対応内容を確認できます。
          </p>
          <span class="mt-4 inline-flex items-center text-sm font-bold text-primary-600">導入事例を見る →</span>
        </a>
      </div>
    </Section>

    <Section variant="light" padding="lg">
      <SectionHeader
        title="ご相談から運用までの流れ"
        subtitle={mode === 'management-dx' ? '単発の壁打ちから始め、必要に応じて継続支援・開発へ進みます' : 'プランを決める前の段階から無料でご相談いただけます'}
        number="05"
        label="FLOW"
      />
      {mode === 'management-dx' && (
        <p class="mx-auto mb-8 max-w-4xl border-l-4 border-primary-500 bg-white p-6 text-base leading-relaxed text-neutral-700">
          壁打ちは導入検討メモのお渡しで完結します。顧問・伴走支援や開発は、ご希望と課題に応じて別途ご提案します。継続契約や開発発注は必須ではありません。
        </p>
      )}
      <ReadingVisual name={mode === 'management-dx' ? 'business-redesign-v1' : 'demo-business-logic-v1'} />
      <figure class="mx-auto max-w-4xl space-y-5 border-l-2 border-primary-200 pl-5">
        {steps.map((step) => (
          <article class="flex flex-col gap-4 rounded-lg border border-neutral-200 bg-white p-6 sm:flex-row sm:items-start sm:gap-6 md:p-8">
            <span class="shrink-0 font-Poppins text-4xl font-bold leading-none text-primary-500">{step.no}</span>
            <div>
              <h2 class="mb-2 text-lg font-bold text-navy-950 md:text-xl">{step.title}</h2>
              <p class="text-sm leading-relaxed text-neutral-700 md:text-base">{step.description}</p>
            </div>
          </article>
        ))}
        <figcaption class="text-sm leading-relaxed text-neutral-600">相談から支援・運用へ進む流れです。次の段階へ進む前に、対象範囲と費用を確認します。</figcaption>
      </figure>
    </Section>

    <Section variant="white" padding="lg">
      <SectionHeader
        title="よくあるご質問"
        subtitle="料金、契約、実装範囲、データの扱いについてまとめました"
        number="06"
        label="FAQ"
      />
      <div class="mx-auto max-w-3xl space-y-4">
        {faqs.map((faq) => (
          <article class="rounded-lg border border-neutral-200 bg-white p-6 md:p-8">
            <h3 class="text-base font-bold text-navy-950 md:text-lg">{faq.question}</h3>
            <p class="mt-4 text-sm leading-relaxed text-neutral-700 md:text-base">{faq.answer}</p>
          </article>
        ))}
      </div>
    </Section>

    <section class="relative overflow-hidden bg-navy-950 py-20 md:py-32">
      <div class="container relative mx-auto max-w-4xl px-6 text-center md:px-8">
        <h2 class="mb-6 text-3xl font-bold text-white md:text-5xl">{page.finalTitle}</h2>
        <p class="mb-10 text-lg leading-relaxed text-white/90 md:text-xl">{page.finalLead}</p>
        <a
          href={`/contact?source=${page.source}-final&intent=${entryIntent}`}
          data-cta-source={`${page.source}-final`}
          data-cta-id="contact"
          class="inline-flex min-h-[56px] items-center justify-center rounded-md bg-white px-6 py-4 text-center text-base font-semibold leading-snug text-accent-950 transition hover:bg-neutral-100 md:px-10 md:text-lg"
        >
          {mode === 'management-dx' ? '90分の壁打ちを申し込む' : '無料相談で状況を整理する'}
          <svg class="ml-3 h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
          </svg>
        </a>
      </div>
    </section>
  </main>
</Layout>
