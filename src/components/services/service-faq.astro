---
import { SectionHeader } from '@/components/ui';
import type { ServiceDetail } from '@/types/service';

interface Props {
  faq: ServiceDetail['faq'];
  number: string;
}

const { faq, number } = Astro.props;

const POC_PRICING_SERVICE_PATHS = new Set([
  '/services/web-mobile-development',
  '/services/mvp-poc-development',
  '/services/ai-development',
  '/services/cdp-development',
  '/services/internal-document-ai-search',
  '/services/rag-system-development',
  '/services/ai-chatbot-development',
  '/services/ocr-ai-development',
  '/services/ai-agent-development',
  '/services/sales-data-coaching',
  '/services/manufacturing-parts-knowledge-search',
  '/services/technical-manual-knowledge-search',
  '/services/internal-it-helpdesk-ai',
  '/services/document-processing-automation',
]);
const pathname = Astro.url.pathname.replace(/\/$/, '');
const showPocPricing = POC_PRICING_SERVICE_PATHS.has(pathname);

function answerWithPricingContext(question: string, answer: string) {
  const isPricingFaq = /費用|料金|予算|いくら/.test(question);
  if (!showPocPricing || !isPricingFaq) return answer;
  return `PoC・小規模検証は80万円〜です。範囲を絞った検証から始められ、実際の金額は要件確認後に個別見積もりします。以下に金額がある場合は、標準的なモデルケースまたは本番開発の目安です。${answer}`;
}
---

<section class="relative overflow-hidden bg-neutral-100 py-20 md:py-28">
  <div class="container relative mx-auto px-6 lg:px-12">
    <div class="mx-auto max-w-4xl">
      <SectionHeader
        client:visible
        title="発注前によくある質問"
        subtitle="発注前に確認されやすい論点をまとめています"
        number={number}
        label="FAQ"
      />
      <div class="divide-y divide-neutral-200 rounded-lg border border-neutral-200 bg-white">
        {faq.map((item) => (
          <details class="group p-6 transition-colors open:bg-neutral-50 hover:bg-neutral-50/60 md:p-7">
            <summary class="flex cursor-pointer list-none items-start justify-between gap-4">
              <span class="flex gap-3 text-lg font-bold leading-snug text-navy-950">
                <span class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-primary-500 text-sm text-white">Q</span>
                {item.question}
              </span>
              <span class="mt-1 text-2xl leading-none text-primary-500 transition group-open:rotate-45">+</span>
            </summary>
            <p class="mt-4 pl-11 text-base leading-relaxed text-neutral-700">
              {answerWithPricingContext(item.question, item.answer)}
            </p>
          </details>
        ))}
      </div>
    </div>
  </div>
</section>
