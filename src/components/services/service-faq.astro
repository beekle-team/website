---
import { SectionHeader } from '@/components/ui';
import type { ServiceDetail } from '@/types/service';

interface Props {
  faq: ServiceDetail['faq'];
  number: string;
}

const { faq, number } = Astro.props;
---

<section class="relative overflow-hidden bg-neutral-100 py-20 md:py-28">
  <div class="container relative mx-auto px-6 lg:px-12">
    <div class="mx-auto max-w-4xl">
      <SectionHeader
        client:visible
        title="発注前によくある質問"
        subtitle="発注前に確認されやすい論点をまとめています"
        number={number}
        label="FAQ"
      />
      <div class="divide-y divide-neutral-200 rounded-lg border border-neutral-200 bg-white">
        {faq.map((item) => (
          <article class="p-6 md:p-7">
            <h3 class="flex items-start gap-3 text-lg font-bold leading-snug text-navy-950">
                <span class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-primary-500 text-sm text-white">Q</span>
                {item.question}
            </h3>
            <p class="mt-4 pl-11 text-base leading-relaxed text-neutral-700">
              {item.answer}
            </p>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>
