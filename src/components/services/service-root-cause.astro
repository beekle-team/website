---
import InformationMap from '@/components/services/information-map.astro';
// 「なぜその問題が起きるのか」を可視化するセクション（生成AIサービスLP共通）
// 共感(PainPoints)と解決策(Solutions)の間に置き、原因を腹落ちさせてから商品提案へ進める。
// design.md: 1画面1アクセント(primary+neutral) / 通し番号ラベルは付けない。
interface Cause {
  title: string;
  description: string;
}

interface RootCause {
  eyebrow: string;
  title: string;
  lead?: string;
  causes: Cause[];
}

interface Props {
  rootCause?: RootCause;
}

const { rootCause } = Astro.props;
---

{rootCause && (
  <section id="root-cause" class="relative overflow-hidden bg-neutral-100 py-20 md:py-28">
    <div class="container relative mx-auto px-8 lg:px-12">
      <div class="max-w-3xl">
        <p class="text-sm font-bold tracking-wide text-primary-500">{rootCause.eyebrow}</p>
        <h2 class="mt-3 text-3xl font-bold leading-tight text-accent-950 md:text-4xl">
          {rootCause.title}
        </h2>
        {rootCause.lead && (
          <p class="mt-4 text-base leading-relaxed text-neutral-700 md:text-lg">{rootCause.lead}</p>
        )}
      </div>

      <div class="mt-10">
        <InformationMap label="問題が起きる背景" items={rootCause.causes} caption="原因として確認する項目を整理しています。どの項目が影響しているかを、実際の業務と資料で確かめます。" />
      </div>
    </div>
  </section>
)}
