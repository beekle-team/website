---
import SectionVisual from '@/components/services/section-visual.astro';
import { SectionHeader } from '@/components/ui';

type RtbItem = { title: string; description: string };

interface Props {
  rtb?: {
    eyebrow: string;
    title: string;
    lead?: string;
    items: readonly RtbItem[];
    note?: { title: string; description: string; href?: string; hrefLabel?: string };
  };
  number?: string;
}

const { rtb, number = '04' } = Astro.props;
---

{
  rtb && (
    <section id="why-beekle" class="relative overflow-hidden bg-neutral-50 py-20 md:py-28">
      <div class="container relative mx-auto px-6 lg:px-12">
        <SectionHeader
          title={rtb.title}
          subtitle={rtb.lead}
          number={number}
          label={rtb.eyebrow}
        />
        <SectionVisual name="delivery-handoff-v1" />
        <div class="mx-auto max-w-4xl divide-y divide-neutral-200">
          {rtb.items.map((item, index) => (
            <div class="py-8">
              <span class="inline-flex h-9 w-9 items-center justify-center rounded-full bg-primary-500 text-sm font-bold text-white">
                {String(index + 1).padStart(2, '0')}
              </span>
              <h3 class="mt-4 text-xl font-bold leading-snug text-navy-950">{item.title}</h3>
              <p class="mt-3 flex-1 text-base leading-relaxed text-neutral-700">
                {item.description}
              </p>
            </div>
          ))}
        </div>
        {rtb.note && (
          <div class="mx-auto mt-6 max-w-6xl rounded-lg border border-primary-200 bg-white p-6 md:p-8">
            <h3 class="text-lg font-bold text-navy-950 md:text-xl">{rtb.note.title}</h3>
            <p class="mt-3 text-base leading-relaxed text-neutral-700">
              {rtb.note.description}
            </p>
            {rtb.note.href && (
              <a
                href={rtb.note.href}
                rel="noopener"
                class="mt-4 inline-flex min-h-[44px] items-center text-sm font-bold text-primary-600 hover:text-primary-700"
              >
                {rtb.note.hrefLabel ?? rtb.note.href}
                <span aria-hidden="true" class="ml-1">→</span>
              </a>
            )}
          </div>
        )}
      </div>
    </section>
  )
}
