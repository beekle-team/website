---
interface Props {
  flow?: {
    eyebrow: string;
    title: string;
    lead: string;
    steps: readonly {
      label: string;
      title: string;
      description: string;
    }[];
    outcome: string;
  };
}

const { flow } = Astro.props;
---

{flow && (
  <section class="relative overflow-hidden bg-neutral-50 py-16 md:py-20">
    <div class="container relative mx-auto px-6 lg:px-12">
      <div class="mx-auto max-w-6xl">
        <div class="max-w-3xl">
          <p class="text-sm font-bold tracking-wide text-primary-500">{flow.eyebrow}</p>
          <h2 class="mt-3 text-3xl font-bold leading-tight text-accent-950 md:text-4xl">
            {flow.title}
          </h2>
          <p class="mt-4 text-base leading-relaxed text-neutral-700 md:text-lg">{flow.lead}</p>
        </div>

        <figure class="mt-8 grid max-w-4xl gap-3">
          {flow.steps.map((step, index) => (
            <>
              <article class:list={[
                'rounded-lg border p-5 md:p-6 md:grid md:grid-cols-[180px_1fr] md:gap-x-6',
                index === 0
                  ? 'border-neutral-200 bg-neutral-50'
                  : index === flow.steps.length - 1
                    ? 'border-primary-200 bg-primary-50'
                    : 'border-primary-200 bg-primary-50',
              ]}>
                <div class="flex items-center gap-3">
                  <span class:list={[
                    'flex h-9 w-9 shrink-0 items-center justify-center rounded-full text-sm font-bold text-white',
                    index === 0
                      ? 'bg-neutral-500'
                      : index === flow.steps.length - 1
                        ? 'bg-primary-600'
                        : 'bg-primary-500',
                  ]}>
                    {index + 1}
                  </span>
                  <p class="text-xs font-bold tracking-wide text-primary-600">{step.label}</p>
                </div>
                <h3 class="mt-4 md:mt-0 text-xl font-bold leading-snug text-accent-950">{step.title}</h3>
                <p class="mt-3 md:col-start-2 text-base leading-relaxed text-neutral-700">{step.description}</p>
              </article>
              {index < flow.steps.length - 1 && (
                <div class="flex items-center justify-center text-primary-400" aria-hidden="true">
                  <span class="text-2xl font-bold">↓</span>
                </div>
              )}
            </>
          ))}
          <figcaption class="mt-3 text-sm leading-relaxed text-neutral-600">現在の業務から、Beekleが設計する対応、導入後に目指す状態への流れです。実際の効果は検証で確認します。</figcaption>
        </figure>

        <div class="mt-5 flex items-start gap-3 rounded-lg bg-accent-950 p-4 text-white md:px-5">
          <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-secondary-400 text-sm font-bold text-accent-950">
            ✓
          </span>
          <p class="text-sm font-bold leading-relaxed md:text-base">{flow.outcome}</p>
        </div>
      </div>
    </div>
  </section>
)}
