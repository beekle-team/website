---
import InformationMap from '@/components/services/information-map.astro';
import { SectionHeader } from '@/components/ui';
import ReadingVisual from '@/components/visuals/reading-visual.astro';
import { serviceReadingVisuals } from '@/data/service-reading-visuals';
import type { ServiceDetail } from '@/types/service';
interface Props {
  solutions: ServiceDetail['solutions'];
  number?: string;
  title?: string;
  subtitle?: string;
}
const {
  solutions,
  number = '02',
  title = 'つまずきを、設計で防ぐ',
  subtitle = 'PoCで終わらせず、業務で使える状態まで設計します',
} = Astro.props;
const visualName =
  serviceReadingVisuals[Astro.url.pathname.split('/').filter(Boolean).pop() ?? '']?.solution;
---
<section id="solutions" class="relative bg-neutral-50 py-16 md:py-20">
  <div class="container mx-auto px-6 lg:px-12">
    <SectionHeader title={title} subtitle={subtitle} number={number} />
    {visualName ? <>
      <ReadingVisual name={visualName} />
      <details class="mx-auto mt-6 max-w-4xl rounded-lg border border-neutral-300 bg-white p-5 md:p-6">
        <summary class="cursor-pointer py-2 text-lg font-bold text-accent-950">対応内容と設計条件の詳細</summary>
        <div class="mt-6"><InformationMap label="設計する範囲" items={solutions} caption="開発で対応する範囲を整理した図です。必要な項目と優先順位は、業務・データ・既存システムを確認して決めます。" /></div>
      </details>
    </> : <InformationMap label="設計する範囲" items={solutions} caption="開発で対応する範囲を整理した図です。必要な項目と優先順位は、業務・データ・既存システムを確認して決めます。" />}

  </div>
</section>
