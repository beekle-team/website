---
import ServiceFigure from '@/components/services/service-figure.astro';
import explanations from '@/data/visual-explanations.json';
interface Props {
  name: string;
  eager?: boolean;
}
const { name, eager = false } = Astro.props;
const entry = (explanations as Record<string, string[]>)[name];
const portrait =
  /^(decision-materials|prototype-feedback|reuse-foundation|demo-business-logic|data-action|sales-next-action|data-quality|knowledge-handover|business-redesign)-/.test(
    name
  );
---
{entry && <div class:list={['mx-auto my-8 w-full', portrait ? 'max-w-md' : 'max-w-3xl']} data-reading-visual={name}>
  <ServiceFigure name={name} alt={entry[0]} caption={entry[1]} width={portrait ? 1024 : 1536} height={portrait ? 1536 : 1024} eager={eager} />
</div>}
